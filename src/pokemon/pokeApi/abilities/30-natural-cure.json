    "effect_entries": [
        {
            "language": "fr",
            "effect": "Ce Pokémon est soigné de n'importe quelle altération majeure de statut quand il est retiré pour un autre Pokémon.\n\nSi ce talent est acquis au cours d'un combat, le Pokémon est soigné lorsqu'il quitte le combat avant de perdre le talent temporaire.",
            "short_effect": "Soigne n'importe quelle altération majeure de statut en se retirant."
        },
        {
            "language": "de",
            "effect": "Wenn ein Pokémon mit dieser Fähigkeit ausgewechselt wird, wird es von einer etwaigen Primäre Statusveränderungen geheilt.\n\nWenn diese Fähigkeit während des Kampfes erlangt wird, wird das Pokémon beim Auswechseln geheilt, bevor es die Fähigkeit wieder verliert.",
            "short_effect": "Heilt jede Primäre Statusveränderungen beim Auswechseln"
        },
        {
            "language": "en",
            "effect": "This Pokémon is cured of any major status ailment when it is switched out for another Pokémon.\n\nIf this ability is acquired during battle, the Pokémon is cured upon leaving battle before losing the temporary ability.",
            "short_effect": "Cures any major status ailment upon switching out."
        }
    ],
