    "effect_entries": [
        {
            "language": "fr",
            "effect": "Lorsqu'une capacité de type Eau touche ce Pokémon, elle lui soigne 1/4 de ses PV max, annulant tous les autres effets.\n\nLes capacités Eau ignorent le Clonage de ce Pokémon.",
            "short_effect": "Absorbe les capacités Eau, soignant 1/4 des PV max."
        },
        {
            "language": "de",
            "effect": "Wenn ein Pokémon mit dieser Fähigkeit von einer Wasser Attacke getroffen wird, wird es um 1/4 seiner maximalen KP geheilt. Jeder andere Effekt der Attacke wird ignoriert.\n\nWasser Attacken ignorieren den Delegator dieses Pokémons.",
            "short_effect": "Absorbiert Wasser Attacken und heilt 1/4 der maximalen KP."
        },
        {
            "language": "en",
            "effect": "Whenever a Water-type move hits this Pokémon, it heals for 1/4 of its maximum HP, negating any other effect on it.\n\nWater moves will ignore this Pokémon's Substitute.",
            "short_effect": "Absorbs Water moves, healing for 1/4 max HP."
        }
