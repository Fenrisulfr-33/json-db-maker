    "effect_entries": [
        {
            "language": "fr",
            "effect": "Ce Pokémon est immunisé aux capacités marquées comme basées sur le son.\n\nGlas de Soin n'est pas affecté.  Brouhaha empêche toujours ce Pokémon de dormir.  Ce Pokémon peut encore recevoir un compteur de Requiem via Relais, et gardera un compter de Requiem s'il acquiet ce talent après que Requiem est utilisée.\n\nGrondement, Hurle-Temps, Sonic Boom, et Bâillement ne sont pas marquées comme basées sur le son.",
            "short_effect": "Protège contre les capacités basées sur le son."
        },
        {
            "language": "de",
            "effect": "Pokémon mit dieser Fähigkeit sind immun gegen Attacken die schallbasiert sind.\n\nVitalglocke wird nicht verhindert. Aufruhr hindert die Pokémon trotzdem am einschlafen. Dieses Pokémon kann trotzdem einen Abgesang Zähler durch Stafette erhalten, und es wird einen Zähler behalten, wenn es die Fähigkeit nach Einsatz von Abgesang erhalten hat.\n\nJauler, Zeitenlärm, Ultraschall und Gähner sind keine schallbasierten Attacken.",
            "short_effect": "Schütz vor Schall Attacken."
        },
        {
            "language": "en",
            "effect": "This Pokémon is immune to moves flagged as being sound-based.\n\nHeal Bell is unaffected.  Uproar still prevents this Pokémon from sleeping.  This Pokémon can still receive a Perish Song counter through Baton Pass, and will retain a Perish Song counter if it acquires this ability after Perish Song is used.\n\nHowl, Roar of Time, Sonic Boom, and Yawn are not flagged as sound-based.",
            "short_effect": "Protects against sound-based moves."
        }
    ],
    "effect_changes": [
        {
            "game": "black-white",
            "effect_entries": [
                {
                    "language": "fr",
                    "effect": "Empêche Glas de Soin de soigner le Pokémon, que ce soit en combat ou non."
                },
                {
                    "language": "de",
                    "effect": "Hindert Vitalglocke daran, das Pokémon zu heilen, auch außerhalb vom Kampf."
                },
                {
                    "language": "en",
                    "effect": "Prevents Heal Bell from curing the Pokémon, whether or not it is in battle."
                }
            ]
        }
    ],
