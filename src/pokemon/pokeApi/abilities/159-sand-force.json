    "effect_entries": [
        {
            "language": "fr",
            "effect": "Pendant une tempête de sable, les capacités de type Roche, Sol, et Acier de ce Pokémon ont 1.3× leur puissance de base.  Ce Pokémon ne subit pas les dégâts de la tempête de sable, peu importe son type.",
            "short_effect": "Renforce les capacités Roche, Sol, et Acier d'1.3× leur puissance sous une tempête de sable.  Protège contre les dégâts de la tempête de sable."
        },
        {
            "language": "de",
            "effect": "Die Gestein, Boden und Stahl Attacken von Pokémon mit dieser Fähigkeit haben während eines Sandsturms 1,3× so viel Basisstärke wie sonst. Das Pokémon erleidet keinen Schaden durch Sandstürme, unabhängig von seinem Typ.",
            "short_effect": "Verstärkt Gestein, Boden und Stahl Attacken um 30% während eines Sandsturms. Schützt vor Schäden durch Sandstürme."
        },
        {
            "language": "en",
            "effect": "During a sandstorm, this Pokémon's Rock-, Ground-, and Steel-type moves have 1.3× their base power.  This Pokémon does not take sandstorm damage, regardless of type.",
            "short_effect": "Strengthens Rock, Ground, and Steel moves to 1.3× their power during a sandstorm.  Protects against sandstorm damage."
        }
