    "effect_entries": [
        {
            "language": "fr",
            "effect": "Pendant une tempête de sable, l'esquive de ce Pokémon augmente de 25%, et il ne prend pas les dégâts de la tempête de sable peu importe son type.\n\nLe bonus d'esquive ne compte pas comme une modification de stat.\n\nMonde extérieur: Si le Pokémon en tête d'équipe a ce talent, le taux de rencontre sauvage est divisé par deux dans une tempête de sable.",
            "short_effect": "Augmente l'esquive de 25% pendant une tempête de sable.  Protège contre les dégâts de la tempête de sable."
        },
        {
            "language": "de",
            "effect": "Während eines Sandsturms hat ein Pokémon mit dieser Fähigkeit einen um 25% erhöhten Fluchtwert und es nimmt keinen Schaden durch Sandstürme.\n\nDer Bonus zählt nicht als Statuswerte Änderung.\n\nAußerhalb vom Kampf: Wenn ein Pokémon mit dieser Fähigkeit an erster Stelle im Team steht, tauchen im Sandsturm nur halb so viele Pokémon auf.",
            "short_effect": "Erhöht den Fluchtwert um 25% während eines Sandsturms. Kein Schaden durch Sandstürme."
        },
        {
            "language": "en",
            "effect": "During a sandstorm, this Pokémon has 1.25× its evasion, and it does not take sandstorm damage regardless of type.\n\nThe evasion bonus does not count as a stat modifier.\n\nOverworld: If the lead Pokémon has this ability, the wild encounter rate is halved in a sandstorm.",
            "short_effect": "Increases evasion to 1.25× during a sandstorm.  Protects against sandstorm damage."
        }
    ],
