    "effect_entries": [
        {
            "language": "fr",
            "effect": "Ce Pokémon ne peut pas recevoir d’altération majeure de statut sous soleil intense.\n\nCe talent ne soigne pas les altérations de statut précédentes.  Repos échouera complètement avec ce talent activé.  Bâillement échouera immédiatement si utilisé sur ce Pokémon sous soleil intense, et un Bâillement déjà utilisé échouera si la météo devient un soleil intense pendant ce entretemps.",
            "short_effect": "Protège contre les altérations majeures de statut sous soleil intense."
        },
        {
            "language": "de",
            "effect": "Pokémon mit dieser Fähigkeit können während starkem Sonnenlicht keine Primäre Statusveränderungen erleiden.\n\nDie Fähigkeit heilt keine Primäre Statusveränderungen. Erholung schlägt fehl während die Fähigkeit aktiv ist. Gähner schlägt sofort fehl wenn es während starkem Sonnenlicht gegen ein Pokémon mit dieser Fähigkeit benutzt wird und ein bereits eingesetzter Gähner schlägt fehl, wenn sich das Wetter zu starkem Sonnenlicht ändert.",
            "short_effect": "Schützt vor Primäre Statusveränderungen während starkem Sonnenlicht."
        },
        {
            "language": "en",
            "effect": "This Pokémon cannot be given a major status ailment during strong sunlight.\n\nThis ability does not heal prior status ailments.  Rest will fail altogether with this ability in effect.  Yawn will immediately fail if used on this Pokémon during strong sunlight, and an already-used Yawn will fail if the weather turns to strong sunlight in the meantime.",
            "short_effect": "Protects against major status ailments during strong sunlight."
        }
    ],
    "effect_changes": [
        {
            "game": "black-white",
            "effect_entries": [
                {
                    "language": "fr",
                    "effect": "Repos fonctionne de manière habituelle sous le soleil intense."
                },
                {
                    "language": "de",
                    "effect": "Erholung funktioniert normal bei starkem Sonnenlicht."
                },
                {
                    "language": "en",
                    "effect": "Rest works as usual during strong sunlight."
                }
            ]
        }
    ],
