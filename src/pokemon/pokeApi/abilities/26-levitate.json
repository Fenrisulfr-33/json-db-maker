    "effect_entries": [
        {
            "language": "fr",
            "effect": "Ce Pokémon est immunisé aux capacités de type Sol, Picots, Pics Toxik, et Piège Sable.\n\nCe talent est désactivé sous Gravité ou Racines, ou en tenant une Balle Fer.  Ce talent n'est pas désactivé sous Atterrissage.",
            "short_effect": "Évite les capacités Sol."
        },
        {
            "language": "de",
            "effect": "Ein Pokémon mit dieser Fähigkeit ist immun gegen Boden Attacken, Stachler, Giftspitzen und Ausweglos.\n\nDiese Fähigkeit wird mit Erdanziehung oder Verwurzler deaktiviert oder während eine Eisenkugel getragen wird. Ruheort deaktiviert diese Fähigkeit nicht.",
            "short_effect": "Verhindert Boden Attacken"
        },
        {
            "language": "en",
            "effect": "This Pokémon is immune to Ground-type moves, Spikes, Toxic Spikes, and Arena Trap.\n\nThis ability is disabled during Gravity or Ingrain, or while holding an Iron Ball.  This ability is not disabled during Roost.",
            "short_effect": "Evades Ground moves."
        }
    ],
