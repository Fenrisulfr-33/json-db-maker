{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pokemon-database.com/schemas/move.json",
  "title": "Pokemon Move",
  "description": "Schema for Pokemon move data validation",
  "type": "object",
  "required": ["_id", "key", "name", "type", "category", "generation"],
  "properties": {
    "_id": {
      "type": "integer",
      "minimum": 1,
      "description": "Unique move ID"
    },
    "key": {
      "type": "string",
      "pattern": "^[a-z0-9-,]+$",
      "description": "URL-safe key identifier"
    },
    "name": {
      "type": "object",
      "required": ["english"],
      "properties": {
        "english": { "type": "string", "minLength": 1 },
        "japanese": { "type": "string" },
        "chinese": { "type": "string" },
        "korean": { "type": "string" },
        "german": { "type": "string" },
        "french": { "type": "string" },
        "italian": { "type": "string" },
        "spanish": { "type": "string" }
      }
    },
    "type": {
      "type": "string",
      "enum": ["Normal", "Fire", "Water", "Electric", "Grass", "Ice", "Fighting", "Poison", "Ground", "Flying", "Psychic", "Bug", "Rock", "Ghost", "Dragon", "Dark", "Steel", "Fairy"]
    },
    "category": {
      "type": "string",
      "enum": ["Physical", "Special", "Status"]
    },
    "contest": {
      "type": ["string", "null"],
      "enum": ["Cool", "Beautiful", "Cute", "Clever", "Tough", null]
    },
    "pp": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    },
    "power": {
      "type": ["integer", "null"],
      "minimum": 0,
      "maximum": 255
    },
    "accuracy": {
      "type": ["integer", "null"],
      "minimum": 0,
      "maximum": 100
    },
    "contact": {
      "type": ["boolean", "null"]
    },
    "generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9
    },
    "target": {
      "type": "string",
      "enum": ["selected-pokemon", "all-opponents", "user", "random-opponent", "all-other-pokemon", "entire-field", "user-and-allies", "all-pokemon", "user-or-ally", "ally", "all-allies", "opponents-field"]
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "description": {
      "type": "object",
      "patternProperties": {
        "^[a-z0-9-]+$": {
          "type": "string"
        }
      }
    },
    "effect": {
      "type": "object",
      "required": ["full", "shortEffect"],
      "properties": {
        "full": { "type": "string" },
        "shortEffect": { "type": "string" }
      }
    },
    "priority": {
      "type": "integer",
      "minimum": -7,
      "maximum": 5
    }
  },
  "additionalProperties": false
}
